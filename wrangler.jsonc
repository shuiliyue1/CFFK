{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shuiliyue-shop",
  "compatibility_date": "2026-03-12",
  "main": "vike:server-entry",
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shuiliyue-shop",
      "migrations_dir": "database/migrations",
      // "database_id": "fcc1ab61-fc53-43bf-aae8-8ccd30f8432b" // 一键部署必须注释/
    }
  ],
  "compatibility_flags": [
    "nodejs_compat",
     "global_fetch_strictly_public"
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
}
